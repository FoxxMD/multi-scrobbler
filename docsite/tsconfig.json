{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["build", "build-*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // ported components import types without `import type`; let the transpiler elide them
    "verbatimModuleSyntax": false
  }
}
