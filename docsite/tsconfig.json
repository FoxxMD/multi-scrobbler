{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "node_modules/starlight-changelogs/virtual.d.ts"],
  "exclude": ["build", "build-*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // ported components import types without `import type`; let the transpiler elide them
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": true,
    // `@site/` is the docsite root (as in Docusaurus); `@site/../` reaches the repo root (config examples, etc.)
    "paths": {
      "@site/*": ["./*"]
    }
  }
}
