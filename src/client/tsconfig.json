{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../core/**/*.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../coverage",

    "../../_site",
    "../../docsite",
    "../../build",
    "../stories"
  ]
}
